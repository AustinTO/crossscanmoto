{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crossscanmoto-payment-backend",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crossscanmoto-payments",
      "database_id": "439d5fbd-2b15-4c1f-b2ce-6050ff2ba21a",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "PRICE_METADATA_USD": "24.99",
    "EMAIL_FROM_ADDRESS": "noreply@auth.trusthentic.com",
    "EMAIL_FROM_NAME": "CrossScan Moto",
    "AUTH_DOMAIN": "auth.trusthentic.com"
  }
}
